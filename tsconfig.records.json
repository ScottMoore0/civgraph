{
  "//": "noImplicitAny is on for every file this check owns since the noImplicitAny review (8 Nov 2026: S1a scripts/lib and the storage, config, schema and maps-pipeline files; S1b the loader and scripts/records). tests/unit/typecheck.test.mjs keeps it on.",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "alwaysStrict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitAny": true
  },
  "include": ["scripts/lib/**/*.mjs", "scripts/records/**/*.mjs", "packages/loader/src/**/*.mjs", "packages/schema/src/*.mjs", "packages/storage/src/sqlite.mjs", "packages/config/src/node.mjs",
    "packages/maps-pipeline/src/layer-bounds.mjs", "packages/maps-pipeline/src/safe-artefact-write.mjs"]
}
