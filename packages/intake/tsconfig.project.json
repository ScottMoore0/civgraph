{
  "//": "intake: The intake framework (src/*.mjs). Left out: src/frozen-clock/ (clock.mjs and no-network.mjs, preloaded by --import and imported by nothing; 13 strict findings). One project of npm run check:types:packages (tsc -b config/tsconfig.packages.json, packages/README.md); not tsconfig.json, which esbuild would read.",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "../../tmp/tsbuild/intake",
    "allowJs": true,
    "checkJs": true,
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023"],
    "types": ["node"],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src/*.mjs",
    "src/frozen-clock/*.mjs"
  ],
  "references": [
    { "path": "../config/tsconfig.project.node.json" },
    { "path": "../core/tsconfig.project.json" },
    { "path": "../registries/tsconfig.project.json" },
    { "path": "../types/tsconfig.project.json" }
  ]
}
