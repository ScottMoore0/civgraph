{
  "//": "map: The map app (src/, app/) but its views (tsconfig.project.views.json). src/jquery-shim.js, a classic script loaded by URL, joined on 20 Nov 2026 (w20-refactor). One project of npm run check:types:packages (tsc -b config/tsconfig.packages.json, packages/README.md); not tsconfig.json, which esbuild would read.",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "../../tmp/tsbuild/map",
    "allowJs": true,
    "checkJs": true,
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": [],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src/**/*.js",
    "src/**/*.mjs",
    "src/**/*.d.ts",
    "app/**/*.js",
    "src/renderer/port-plan-client.generated.json"
  ],
  "exclude": [
    "src/views/**"
  ],
  "references": [
    { "path": "../config/tsconfig.project.json" },
    { "path": "../core/tsconfig.project.json" },
    { "path": "./tsconfig.project.views.json" },
    { "path": "../registries/tsconfig.project.browser.json" },
    { "path": "../types/tsconfig.project.json" },
    { "path": "../ui/tsconfig.project.json" },
    { "path": "../ui/tsconfig.project.base.json" }
  ]
}
