{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:civgraph:api:v1:spatial",
  "title": "/api/v1/spatial",
  "description": "Map features of one map in a bounding box. The answer of /_api/spatial, which stays as an alias.",
  "x-civgraph-route": {
    "legacy": "/_api/spatial",
    "parameters": [
      "mapId",
      "bbox"
    ]
  },
  "x-civgraph-variants": [
    {
      "name": "features",
      "when": {
        "mapId": "*"
      },
      "summary": "One map's features in the bounding box"
    }
  ],
  "anyOf": [
    {
      "$ref": "#/$defs/features"
    }
  ],
  "$defs": {
    "features": {
      "description": "One map's features in the bounding box",
      "type": "object",
      "properties": {
        "features": {
          "type": "array"
        }
      },
      "required": [
        "features"
      ]
    },
    "error": {
      "description": "The JSON error answer (4xx, 5xx)",
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        }
      },
      "required": [
        "error"
      ]
    }
  }
}
