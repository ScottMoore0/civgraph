            ]
          }
        },
        "matchedCount": {
          "type": "number"
        },
        "unmatchedCount": {
          "type": "number"
        }
      },
      "required": [
        "election",
        "constituencies",
        "matchedCount",
        "unmatchedCount"
      ]
    },
    "error": {
      "description": "The JSON error answer (4xx, 5xx)",
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        }
      },
      "required": [
        "error"
      ]
    }
  }
}
