          ]
        },
        "candidates": {
          "type": "array"
        },
        "counts": {
          "type": "array"
        },
        "animationPayload": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "constituency",
        "feature",
        "candidates",
        "counts",
        "animationPayload"
      ]
    },
    "contest-by-name": {
      "description": "One contest found by its name",
      "type": "object",
      "properties": {
        "constituency": {
          "type": "object"
        },
        "feature": {
          "type": [
            "object",
            "null"
          ]
        },
        "candidates": {
          "type": "array"
        },
        "counts": {
          "type": "array"
        },
        "animationPayload": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "constituency",
        "feature",
        "candidates",
        "counts",
        "animationPayload"
      ]
    },
    "contest": {
      "description": "One contest by its sequence number",
      "type": "object",
      "properties": {
        "constituency": {
          "type": "object"
        },
        "feature": {
          "type": [
            "object",
            "null"
          ]
        },
        "candidates": {
          "type": "array"
        },
        "counts": {
          "type": "array"
        },
        "animationPayload": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "constituency",
        "feature",
        "candidates",
        "counts",
        "animationPayload"
      ]
    },
    "bundle": {
      "description": "The election bundle (the static file's shape); lite=1 leaves out the counts",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number"
        },
        "key": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "displayTitle": {
          "type": "string"
        },
        "loadable": {
          "type": "boolean"
        }
      },
      "required": [
        "schemaVersion",
        "key",
        "body",
        "date",
        "displayTitle",
        "loadable"
      ]
    },
    "election": {
      "description": "One election with its constituencies",
      "type": "object",
      "properties": {
        "election": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
