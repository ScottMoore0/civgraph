{
  "//": "types: The type declarations: index.d.ts, generated/ and hand/. The generator (src/generate.mjs, a Node script) is tsconfig.project.generator.json. One project of npm run check:types:packages (tsc -b config/tsconfig.packages.json, packages/README.md); not tsconfig.json, which esbuild would read.",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "../../tmp/tsbuild/types",
    "allowJs": true,
    "checkJs": true,
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023"],
    "types": [],
    "resolveJsonModule": true,
    "skipLibCheck": false,
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true
  },
  "include": [
    "index.d.ts",
    "generated/**/*.d.ts",
    "hand/*.d.ts"
  ],
  "references": []
}
