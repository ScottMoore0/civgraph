{
  "//": "storage: The runtime half of the storage package (src/*.js: the RecordStore interface, D1, the blob stores), with the Workers runtime types of functions/_lib/runtime.d.mts. One project of npm run check:types:packages (tsc -b config/tsconfig.packages.json, packages/README.md); not tsconfig.json, which esbuild would read.",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "../../tmp/tsbuild/storage",
    "allowJs": true,
    "checkJs": true,
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": [],
    "skipLibCheck": true,
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true
  },
  "include": [
    "src/*.js",
    "../../functions/_lib/runtime.d.mts"
  ],
  "references": [
    { "path": "../config/tsconfig.project.json" },
    { "path": "../types/tsconfig.project.json" }
  ]
}
