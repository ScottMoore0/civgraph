{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://civgraph.net/schemas/database/approved-publication-sources.schema.json",
  "title": "Approved-publication sources, the index (data/database/approved-publication-sources.json): the approval it records, the counts by tranche, and its shards (approved-publication-sources-shard.schema.json)",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "generatedFrom", "approvalPolicy", "counts", "indexLayout", "shardCount", "shards"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" },
    "generatedFrom": { "type": "object", "additionalProperties": { "type": "string" } },
    "approvalPolicy": { "type": "string", "minLength": 1 },
    "counts": {
      "type": "object",
      "required": ["publish", "variants", "total"],
      "properties": {
        "publish": { "type": "number", "minimum": 0 },
        "variants": { "type": "number", "minimum": 0 },
        "total": { "type": "number", "minimum": 0 }
      }
    },
    "indexLayout": { "const": "sharded" },
    "shardCount": { "type": "number", "minimum": 1 },
    "shards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "count"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string", "pattern": "^data/database/approved-publication-sources-shards/sources-[0-9]{3}[.]json$" },
          "count": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
