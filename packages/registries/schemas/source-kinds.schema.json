{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://civgraph.net/schemas/registries/source-kinds.schema.json",
  "title": "Source-kinds registry (data/registries/source-kinds.json)",
  "type": "object",
  "required": ["schemaVersion", "description", "kinds"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "description": { "type": "string", "minLength": 1 },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "meaning", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)*$", "description": "The kind, as a contest file's source.kind or a citation's kind names it." },
          "meaning": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "description": "What a contest's Sources panel calls the kind; empty shows no kind." }
        }
      }
    }
  }
}
