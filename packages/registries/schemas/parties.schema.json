{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://civgraph.net/schemas/registries/parties.schema.json",
  "title": "Parties registry (data/registries/parties.json joined with the party files it names)",
  "description": "The shape of each party file as its readers use it today. packages/registries/src/parties.mjs checkParties holds the cross-file rules. party-events.json keeps its own schema (data/schemas/party-events.schema.json, check:facts); here only its envelope is held.",
  "type": "object",
  "required": ["schemaVersion", "description", "parts", "abbreviations", "notParties", "entities", "lifespans", "lineage", "events", "wikidata", "wikidataOverrides", "labelIds", "labelFolds", "labelInterpretations", "colourReviewOverrides", "palettes"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "description": { "type": "string", "minLength": 1 },
    "parts": {
      "type": "object",
      "required": ["entities", "lifespans", "lineage", "events", "wikidata", "wikidataOverrides", "labelIds", "labelFolds", "labelInterpretations", "colourReviewOverrides", "palettes"],
      "additionalProperties": false,
      "properties": {
        "entities": { "$ref": "#/$defs/path" }, "lifespans": { "$ref": "#/$defs/path" }, "lineage": { "$ref": "#/$defs/path" },
        "events": { "$ref": "#/$defs/path" }, "wikidata": { "$ref": "#/$defs/path" }, "wikidataOverrides": { "$ref": "#/$defs/path" },
        "labelIds": { "$ref": "#/$defs/path" }, "labelFolds": { "$ref": "#/$defs/path" }, "labelInterpretations": { "$ref": "#/$defs/path" },
        "colourReviewOverrides": { "$ref": "#/$defs/path" }, "palettes": { "$ref": "#/$defs/path" }
      }
    },
    "abbreviations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["abbreviation", "fullName"],
        "additionalProperties": false,
        "properties": {
          "abbreviation": { "type": "string", "minLength": 1 },
          "fullName": { "type": "string", "minLength": 1 },
          "spellings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "notParties": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "entities": {
      "type": "object",
      "required": ["schemaVersion", "description", "idPolicy", "types", "aliasResolution", "provisional", "entities"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "description": { "type": "string" }, "idPolicy": { "type": "string" }, "aliasResolution": { "type": "string" }, "provisional": { "type": "string" },
        "types": { "type": "object", "additionalProperties": { "type": "string" } },
        "entities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entity" } }
      }
    },
    "lifespans": {
      "type": "object",
      "required": ["schemaVersion", "description", "conventions", "parties"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 }, "description": { "type": "string" },
        "conventions": { "type": "object", "additionalProperties": { "type": "string" } },
        "parties": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "founded", "status"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/id" }, "name": { "type": "string" }, "shortName": { "type": ["string", "null"] },
              "founded": { "type": ["string", "null"] }, "foundedPrecision": { "$ref": "#/$defs/precision" },
              "dissolved": { "type": ["string", "null"] }, "status": { "$ref": "#/$defs/status" },
              "partyStrings": { "type": "array", "items": { "$ref": "#/$defs/alias" } }, "corruptedStrings": { "type": "array", "items": { "type": "string" } },
              "source": { "type": ["string", "null"] }, "confidence": { "$ref": "#/$defs/confidence" }, "notes": { "type": ["string", "null"] },
              "foundedNote": { "type": "string" }, "splitFrom": { "$ref": "#/$defs/id" }, "revivalOf": { "$ref": "#/$defs/id" },
              "successor": { "$ref": "#/$defs/id" }, "predecessor": { "$ref": "#/$defs/id" }
            }
          }
        }
      }
    },
    "lineage": {
      "type": "object",
      "required": ["schemaVersion", "description", "sources", "events"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 }, "description": { "type": "string" },
        "sources": { "type": "object", "additionalProperties": { "type": "string" } },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["party", "kind", "text"],
            "additionalProperties": false,
            "properties": {
              "party": { "$ref": "#/$defs/id" },
              "kind": { "enum": ["founded", "split", "renamed", "dissolved", "note"] },
              "date": { "$ref": "#/$defs/date" }, "precision": { "$ref": "#/$defs/precision" },
              "text": { "type": "string", "minLength": 1 }, "basis": { "type": "string" }, "note": { "type": "string" },
              "related": { "type": "array", "items": { "type": "object", "required": ["party", "relation"], "additionalProperties": false, "properties": { "party": { "$ref": "#/$defs/id" }, "relation": { "type": "string", "minLength": 1 } } } },
              "citations": { "type": "array", "items": { "type": "object" } }
            }
          }
        }
      }
    },
    "events": { "type": "object", "required": ["events"] },
    "wikidata": {
      "type": "object",
      "required": ["schemaVersion", "retrieved", "source", "matchRule", "counts", "matches", "uncertain", "unmatched"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "matches": { "type": "object", "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "type": "object", "required": ["qid"], "properties": { "qid": { "type": "string", "pattern": "^Q\\d+$" } } } },
        "uncertain": { "type": "array", "items": { "type": "object", "required": ["slug"] } },
        "unmatched": { "type": "array", "items": { "type": "object", "required": ["slug"] } }
      }
    },
    "wikidataOverrides": { "type": "object", "required": ["_note"], "additionalProperties": { "type": ["string", "null"] } },
    "labelIds": {
      "type": "object",
      "required": ["party_ids", "aliases"],
      "properties": {
        "party_ids": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["party_id", "canonical_name"],
            "additionalProperties": false,
            "properties": {
              "party_id": { "type": "string", "pattern": "^party:" }, "canonical_name": { "type": "string" },
              "observed_names": { "type": "array", "items": { "type": "string" } }, "known_aliases": { "type": "array", "items": { "type": "string" } },
              "occurrence_count": { "type": "integer", "minimum": 0 }, "file_count": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "aliases": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^party:" } }
      }
    },
    "labelFolds": {
      "type": "object",
      "required": ["description", "folds", "neverFold", "retiredSlugs"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "folds": { "type": "object", "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/reasonedList" } },
        "neverFold": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "retiredSlugs": { "type": "object", "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "type": "object", "required": ["reason", "slugs"], "additionalProperties": false, "properties": { "reason": { "type": "string" }, "slugs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } } } } }
      }
    },
    "labelInterpretations": {
      "type": "object",
      "required": ["description", "dittoMarks", "noLabel", "regions", "rules"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "dittoMarks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "noLabel": { "type": "object", "required": ["printed"], "properties": { "printed": { "type": "array", "items": { "type": "string" } } } },
        "unresolved": { "type": "array", "items": { "type": "object", "required": ["printed"] } },
        "regions": { "type": "object", "additionalProperties": { "type": "object", "required": ["bodies"], "additionalProperties": false, "properties": { "description": { "type": "string" }, "bodies": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } } } },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["party", "evidence"],
            "additionalProperties": false,
            "properties": {
              "printed": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "whenParty": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "party": { "type": "string" }, "evidence": { "type": "string", "minLength": 1 },
              "bodies": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }, "region": { "type": "string" },
              "from": { "$ref": "#/$defs/date" }, "until": { "$ref": "#/$defs/date" }, "override": { "type": "boolean" },
              "candidates": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "palettes": {
      "type": "object",
      "description": "The party colour palettes the code draws with (data/registries/parties/palettes.json): each an ordered list keyed by the party name as its reader folds it.",
      "required": ["description", "elections", "mapLocal", "mapRoi", "viewer", "neutral", "placeholders"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "elections": { "$ref": "#/$defs/palette" },
        "mapLocal": { "$ref": "#/$defs/palette" },
        "mapRoi": { "$ref": "#/$defs/palette" },
        "viewer": { "$ref": "#/$defs/palette", "description": "The STV count viewer's table (site/app/election-viewer-package/js/stages2.js getPartyColour): each party as the table wrote it, which the viewer folds with its own normalisePartyKey; where two rows fold alike the later row's colour wins." },
        "neutral": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "description": "The colour of a party with none of its own, or of no party (the build's fallback slate; NEUTRAL_PARTY_COLOUR)." },
        "placeholders": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }, "description": "The neutral greys importers wrote as placeholders: like `neutral`, a colour that means no colour (isPlaceholderPartyColour)." }
      }
    },
    "colourReviewOverrides": {
      "type": "object",
      "required": ["schemaVersion", "description", "records"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 }, "description": { "type": "string" },
        "records": { "type": "array", "items": { "type": "object", "required": ["party", "status"], "properties": { "electionColour": { "$ref": "#/$defs/colour" }, "wikipediaColour": { "$ref": "#/$defs/colour" } } } }
      }
    }
  },
  "$defs": {
    "palette": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["party", "colour"],
        "additionalProperties": false,
        "properties": {
          "party": { "type": "string", "minLength": 1, "description": "The party name as the reader folds it." },
          "colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "registryWins": { "const": true, "description": "Drawn in this colour even where the result file has one of its own (resolvePartyColour)." },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "path": { "type": "string", "pattern": "^(data|scripts)/[^\\s]+\\.json$" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "date": { "type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$" },
    "precision": { "enum": ["day", "month", "year", null] },
    "status": { "enum": ["active", "dissolved", "unknown", "historical"] },
    "confidence": { "enum": ["high", "medium", "provisional", "unreviewed"] },
    "colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "reasonedList": { "type": "object", "required": ["reason", "labels"], "additionalProperties": false, "properties": { "reason": { "type": "string" }, "labels": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } },
    "alias": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "object", "required": ["string"], "additionalProperties": false, "properties": { "string": { "type": "string", "minLength": 1 }, "corrupted": { "type": "boolean" }, "bodies": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "from": { "$ref": "#/$defs/date" }, "until": { "$ref": "#/$defs/date" } } }
      ]
    },
    "entity": {
      "type": "object",
      "required": ["id", "type", "name", "aliases"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "shortName": { "type": ["string", "null"] },
        "aliases": { "type": "array", "items": { "$ref": "#/$defs/alias" } },
        "founded": { "type": ["string", "null"] }, "foundedPrecision": { "$ref": "#/$defs/precision" }, "foundedNote": { "type": "string" },
        "dissolved": { "type": ["string", "null"] }, "dissolvedPrecision": { "$ref": "#/$defs/precision" },
        "status": { "$ref": "#/$defs/status" }, "source": { "type": ["string", "null"] }, "confidence": { "$ref": "#/$defs/confidence" },
        "provisional": { "type": "boolean" }, "notes": { "type": ["string", "null"] },
        "splitFrom": { "$ref": "#/$defs/id" }, "successor": { "$ref": "#/$defs/id" }, "predecessor": { "$ref": "#/$defs/id" },
        "formerIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "nameHistory": { "type": "array", "items": { "type": "object", "required": ["name"] } },
        "observed": { "type": "object" },
        "colour": { "$ref": "#/$defs/colour" }, "colourSource": { "type": "string" }
      }
    }
  }
}
