{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://civgraph.net/schemas/registries/election-bodies.schema.json",
  "title": "Election-bodies registry (data/registries/election-bodies.json)",
  "type": "object",
  "required": ["schemaVersion", "description", "bodies", "groups"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "description": { "type": "string", "minLength": 1 },
    "bodies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/body" }
    },
    "groups": {
      "type": "object",
      "description": "How the site groups the bodies (the registry's description says where each list is read).",
      "required": ["description", "catalogueShelves", "partyCharts", "catalogueOrder", "electionsHome", "entityHistory"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "catalogueShelves": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label", "bodies", "icon"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/slug" },
              "label": { "type": "string", "minLength": 1 },
              "bodies": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
              "councilFlag": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$", "description": "Adds the bodies of the councils registry's councils with this flag." },
              "icon": { "$ref": "#/$defs/slug" },
              "note": { "type": "string", "minLength": 1 }
            }
          }
        },
        "partyCharts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label", "match"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/slug" },
              "label": { "type": "string", "minLength": 1 },
              "match": { "$ref": "#/$defs/match" },
              "note": { "type": "string", "minLength": 1 }
            }
          }
        },
        "catalogueOrder": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
        "electionsHome": { "$ref": "#/$defs/labelledGroups" },
        "entityHistory": { "$ref": "#/$defs/labelledGroups" }
      }
    }
  },
  "$defs": {
    "match": {
      "type": "object",
      "description": "What a group takes: a value one of `bodies`, starting with one of `prefixes`, containing one of `contains`, or matching `pattern` (case-insensitive).",
      "additionalProperties": false,
      "properties": {
        "bodies": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slug" } },
        "prefixes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "contains": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "pattern": { "type": "string", "minLength": 1 }
      }
    },
    "labelledGroups": {
      "type": "object",
      "required": ["groups", "fallback", "order"],
      "additionalProperties": false,
      "properties": {
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label", "match"],
            "additionalProperties": false,
            "properties": { "label": { "type": "string", "minLength": 1 }, "match": { "$ref": "#/$defs/match" } }
          }
        },
        "fallback": { "type": "string", "minLength": 1, "description": "The group of a value no group takes." },
        "order": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 }, "description": "The groups in display order: every group and the fallback." }
      }
    },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "body": {
      "type": "object",
      "description": "One election body. Only id, name, jurisdiction and sources are required: a body lists the facts the code reads from here, and the others stay where they were.",
      "required": ["id", "name", "jurisdiction", "sources"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug", "description": "The body slug: its folder under data/elections-source/data/elections/ and the prefix of its election keys." },
        "name": { "type": "string", "minLength": 1, "description": "The body as data/elections-source/data/elections_index.json names it." },
        "officialName": { "type": "string", "minLength": 1 },
        "jurisdiction": { "enum": ["ireland", "northern-ireland", "island"] },
        "typeLabel": { "type": "string", "minLength": 1, "description": "The kind of election, as the map app's candidate and party pages label it." },
        "shortLabel": { "type": "string", "minLength": 1, "description": "The body on a catalogue Elections row." },
        "shelf": { "$ref": "#/$defs/slug", "description": "The catalogue's Elections shelf (src/catalogue/view-elections.js BODY_GROUPS id)." },
        "searchTerms": { "type": "string", "minLength": 1, "description": "Words the catalogue search matches the body's elections by." },
        "title": { "type": "string", "pattern": "\\{year\\}", "description": "An election's title; {year} is its year." },
        "wikipediaTitle": { "type": "string", "pattern": "\\{year\\}", "description": "The English Wikipedia article on an election, where no resolved article is on file; {year} is its year." },
        "wholeArea": { "type": "boolean", "description": "Every election of the body is held over its whole area, so none is a by-election." },
        "votingSystem": { "enum": ["stv-hare", "stv-gregory", "fptp", "block-vote", "party-list-dhondt", "ordinal"] },
        "partyGroup": {
          "type": "object",
          "required": ["id", "label"],
          "additionalProperties": false,
          "properties": { "id": { "$ref": "#/$defs/slug" }, "label": { "type": "string", "minLength": 1 } }
        },
        "geography": {
          "type": "array",
          "minItems": 1,
          "description": "The maps the body's elections are drawn on, each from a date (an election takes the latest rule on or before its date).",
          "items": {
            "type": "object",
            "required": ["from", "sourceMapId"],
            "additionalProperties": false,
            "properties": {
              "from": { "$ref": "#/$defs/date" },
              "sourceMapId": { "type": "string", "minLength": 1 },
              "featureOverrides": {
                "type": "object",
                "description": "A result's name -> the feature of the map it is drawn on, where the two are written differently.",
                "additionalProperties": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "areaResults": {
          "type": "object",
          "required": ["dir", "modeId", "labels", "note"],
          "additionalProperties": false,
          "properties": {
            "dir": { "type": "string", "pattern": "^data/elections/[a-z0-9-]+$", "description": "The folder of the area results, one subfolder per election date: an _constituencies.json index (its sourceMapId is the map that date's areas are drawn on) and one file per area." },
            "modeId": { "$ref": "#/$defs/slug", "description": "The id of the election's geography mode that shows them." },
            "labels": {
              "type": "object",
              "description": "The geography mode's label in the map app, by the counting basis an election's _constituencies.json gives.",
              "propertyNames": { "$ref": "#/$defs/slug" },
              "additionalProperties": { "type": "string", "minLength": 1 }
            },
            "note": { "type": "string", "minLength": 1 }
          }
        },
        "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
