{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://civgraph.net/schemas/registries/councils.schema.json",
  "title": "Councils registry (data/registries/councils.json)",
  "description": "Every council the site files elections, offices or boundaries under. registries/councils.mjs holds the checks a schema cannot state (unique ids, resolvable references, symmetric relations).",
  "type": "object",
  "required": ["schemaVersion", "description", "sources", "types", "councils"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "description": { "type": "string", "minLength": 1 },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "types": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/slug" },
      "additionalProperties": {
        "type": "object",
        "required": ["source"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "levels": { "type": "array", "uniqueItems": true, "items": { "enum": ["ded", "ced", "towns", "districts", "counties"] } },
          "source": { "type": "string", "minLength": 1 }
        }
      }
    },
    "councils": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/council" } }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "dateOrYear": { "type": "string", "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$" },
    "source": { "type": "string", "pattern": "^(data|scripts|src)/[^\\s]+$" },
    "relation": {
      "type": "object",
      "required": ["id", "basis"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "basis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["type", "source"],
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["abolished", "renamed", "created", "overlap"] },
              "source": { "$ref": "#/$defs/source" }
            }
          }
        }
      }
    },
    "council": {
      "type": "object",
      "required": ["id", "name", "bodySlug", "type", "generation", "jurisdiction"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": ["string", "null"], "minLength": 1, "description": "The elections index name; null when no source names the council." },
        "bodySlug": { "$ref": "#/$defs/slug" },
        "indexName": { "type": "string", "minLength": 1, "description": "The body's name in data/elections-source/data/elections_index.json." },
        "type": { "$ref": "#/$defs/slug" },
        "generation": { "enum": ["pre-1973", "1973", "2014"] },
        "jurisdiction": { "enum": ["northern-ireland", "ireland"] },
        "aldermenOf": { "$ref": "#/$defs/slug" },
        "counties": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["Antrim", "Armagh", "Down", "Fermanagh", "Londonderry", "Tyrone", "Antrim/Down"] } },
        "names": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["name", "basis"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "from": { "$ref": "#/$defs/dateOrYear" },
              "until": { "$ref": "#/$defs/dateOrYear" },
              "basis": { "enum": ["date", "year"] },
              "note": { "type": "string", "minLength": 1 }
            }
          }
        },
        "formerStems": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "searchName": { "type": "string", "minLength": 1 },
        "searchAliases": { "type": "string", "minLength": 1 },
        "officialName": { "type": "string", "minLength": 1 },
        "officialNameAliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "officesInstitution": { "type": "string", "pattern": "^council-[a-z0-9-]+$" },
        "websites": {
          "type": "object",
          "required": ["key", "hosts"],
          "additionalProperties": false,
          "properties": {
            "key": { "type": "string", "minLength": 1 },
            "hosts": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9.-]+$" } }
          }
        },
        "wikipedia": {
          "type": "object",
          "required": ["key", "titleVariants"],
          "additionalProperties": false,
          "properties": {
            "key": { "type": "string", "pattern": "^[a-z_]+$" },
            "titleVariants": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "flags": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "niLocalGroup": { "const": true },
            "pre1973Council": { "const": true },
            "niCouncils1923_67": { "const": true },
            "resultsOnly1923_67": { "const": true },
            "armaghPilot": { "const": true },
            "pr1920Only": { "const": true },
            "localGovernmentGroup": { "const": true }
          }
        },
        "predecessors": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
        "successors": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "between", "text", "source"],
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["abolished", "renamed", "created"] },
              "between": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
              "text": { "type": "string", "minLength": 1 },
              "source": { "$ref": "#/$defs/source" }
            }
          }
        }
      }
    }
  }
}
