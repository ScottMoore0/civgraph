  "id": "ni-plu-dispensary-towns-2026-11-02",
  "title": "NI Poor Law Unions, dispensary districts and Towns Improvement Act towns, 1921-1962",
  "date": "2026-11-02",
  "status": "committed",
  "summary": "Three dispensary-district editions (1 Apr 1921, 1 Apr 1924, 1 Jan 1929) built on the pre-1923 electoral divisions, six Towns Improvement Act town editions (1921-1959), and the Poor Law Unions' end refined to the abolition of the boards on 30 Sep 1948. Describes what the hand-written apply.py and UPLOAD.txt of D:\\civgraph-intake\\ni-plu-dispensary-towns-2026-11-02 did; applied in 2fc8ce45e1.",
  "repo": { "baseCommit": "7d9a2ad556", "commits": ["2fc8ce45e1"] },
  "personalData": { "contains": false, "handling": "none", "note": "Boundaries and catalogue entries only; no names or addresses of people." },
  "sources": [
    { "id": "census-1926", "title": "Census of Population of Northern Ireland 1926: Topographical Index, county volumes (Table 4) and General Report", "publisher": "HMSO Belfast", "note": "Index 9 gives every townland's dispensary district; Table 4 the county-part areas checked against." },
    { "id": "census-1911", "title": "Census of Ireland 1911: county volumes, Table VI", "publisher": "HMSO", "note": "Dispensary-district order of the electoral divisions; used only as a cross-check." },
    { "id": "census-1937", "title": "Census of Population of Northern Ireland 1937: General Report and county volumes", "publisher": "HMSO Belfast" },
    { "id": "belfast-gazette", "title": "The Belfast Gazette, issues 105, 155, 196, 229, 677, 809, 1979 and 2128", "publisher": "The Gazette", "url": "https://www.thegazette.co.uk/Belfast", "licence": "OGL v3.0", "note": "Issue 229 (13 Nov 1925): dispensary districts stay on the pre-1923 divisions." },
    { "id": "sro-1948", "title": "S.R. & O. (NI) 1948 Nos. 175, 187 and 281", "publisher": "legislation.gov.uk", "url": "https://www.legislation.gov.uk/nisro/1948/281/contents/made", "licence": "OGL v3.0", "note": "No. 281 abolished every board of guardians on 30 Sep 1948." },
    { "id": "osni-townlands", "title": "OSNI Largescale Townlands", "publisher": "Land & Property Services (OSNI)", "licence": "OGL v3.0", "note": "Lines for the ten pre-1923 divisions split between districts." }
  ],
