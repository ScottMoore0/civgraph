{
 "schemaVersion": 1,
 "description": "Map layer types: the sourceType of a layer record, the fields every published layer of the type carries (render/metadata/maps-test.json), its tile format, and how the map app treats it (behaviour: packages/map/src/renderer/map-controller.js). Schema: packages/registries/schemas/layer-types.schema.json; views: packages/registries/src/layers.mjs.",
 "behaviourFlags": {
  "threeD": {
   "meaning": "a 3D layer: terrain or a point cloud; turns on the 3D gesture handlers and terrain",
   "source": "packages/map/src/renderer/map-controller.js: THREE_D_TYPES"
  },
  "rasterSource": {
   "meaning": "drawn from raster tiles or an image, so it has no features to pick",
   "source": "packages/map/src/renderer/map-controller.js: RASTER_SOURCE_TYPES"
  },
  "noFeatureState": {
   "meaning": "feature-state (hover, selection) is never set on it",
   "source": "packages/map/src/renderer/map-controller.js: NO_FEATURE_STATE_TYPES"
  },
  "noLabels": {
   "meaning": "never gets a label layer",
   "source": "packages/map/src/renderer/map-controller.js: NO_LABEL_TYPES"
  }
 },
 "types": {
  "image": {
