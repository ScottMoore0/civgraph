{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://civgraph.net/schemas/non-candidate-persons.schema.json",
  "title": "Registered non-candidate persons (data/elections/persons/non-candidate-persons.json)",
  "description": "People Civgraph holds no candidacy for, registered so tenures and affiliations can name them. Ids are a block of their own (idBlock) that the candidate id assignment never reaches; build_person_registry_v2.py adds them with keyedBy 'registered'.",
  "type": "object",
  "required": ["schemaVersion", "description", "idBlock", "persons"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "description": { "type": "string" },
    "idBlock": {
      "type": "object",
      "required": ["from", "to"],
      "properties": { "from": { "const": 900001 }, "to": { "const": 999999 } },
      "additionalProperties": false
    },
    "persons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["personId", "key", "displayName", "aliases", "officialPersonIds", "basis", "citations"],
        "properties": {
          "personId": { "type": "string", "pattern": "^9\\d{5}$" },
          "key": { "type": "string", "minLength": 3 },
          "displayName": { "type": "string", "minLength": 3 },
          "aliases": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "officialPersonIds": {
            "type": "array",
            "items": { "type": "string", "pattern": "^(wikidata:Q\\d+|ukparliament:\\d+|oireachtas:\\S+|niassembly:\\d+)$" }
          },
          "born": { "type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$" },
          "died": { "type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$" },
          "lifeSource": { "type": "string" },
          "basis": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }, "description": "The offices the person is registered for." },
          "citations": { "type": "array", "minItems": 1, "items": { "$ref": "citation.schema.json" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
