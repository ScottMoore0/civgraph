{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://civgraph.net/schemas/affiliations.schema.json",
  "title": "Affiliations (data/elections/persons/affiliations.json)",
  "description": "A person's party affiliation over time as dated intervals: a party, an independent label, a group without a registry party (label), or a party whip. It complements the label each candidacy carries and never overwrites it.",
  "type": "object",
  "required": ["schemaVersion", "description", "affiliations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "description": { "type": "string" },
    "affiliations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "personId", "partyId", "kind", "start", "startPrecision", "startEvent", "end", "endPrecision", "endEvent", "citations"],
        "properties": {
          "id": { "type": "string", "minLength": 5 },
          "personId": { "type": "string", "pattern": "^[1-9]\\d*$" },
          "partyId": { "oneOf": [{ "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }, { "type": "null" }] },
          "label": { "type": "string", "description": "The group's name where it has no party_registry.json id (kind 'group')." },
          "kind": { "enum": ["party", "independent", "group", "whip"] },
          "start": { "$ref": "#/$defs/dateOrNull" },
          "startPrecision": { "$ref": "#/$defs/precisionOrNull" },
          "startEvent": { "enum": ["joined", "founding-member", "elected-as", "left-party", "whip-restored", "defected-from", null] },
          "end": { "$ref": "#/$defs/dateOrNull" },
          "endPrecision": { "$ref": "#/$defs/precisionOrNull" },
          "endEvent": { "enum": ["left", "defected-to", "joined-party", "expelled", "whip-withdrawn", "died", "party-dissolved", null] },
          "note": { "type": "string" },
          "matchedBy": { "type": "string" },
          "citations": { "type": "array", "minItems": 1, "items": { "$ref": "citation.schema.json" } }
        },
        "allOf": [
          { "if": { "properties": { "partyId": { "type": "null" } } }, "then": { "required": ["label"] } }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$" },
    "dateOrNull": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
    "precisionOrNull": { "enum": ["year", "month", "day", null] }
  }
}
