{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://civgraph.net/schemas/party-events.schema.json",
  "title": "Party events (data/elections/parties/party-events.json)",
  "description": "Dated events in a party's life, each cited. partyId and relatedParties[].partyId are party_registry.json ids. The narrative events of party-lineage.json stay where they are; both load into one party_events table (docs/facts-model.md).",
  "type": "object",
  "required": ["schemaVersion", "description", "events"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "description": { "type": "string" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "partyId", "date", "precision", "type", "citations"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+:[a-z-]+:\\d{4}(-\\d{2}){0,2}$" },
          "partyId": { "$ref": "#/$defs/slug" },
          "date": { "type": "string", "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$" },
          "precision": { "enum": ["year", "month", "day"] },
          "type": {
            "enum": ["founded", "dissolved", "renamed", "merged-into", "split-from", "split", "began-organising-in-ni",
              "first-contested", "last-contested", "suspended", "re-formed", "registered"]
          },
          "relatedParties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["partyId", "relation"],
              "properties": { "partyId": { "$ref": "#/$defs/slug" }, "relation": { "type": "string" } },
              "additionalProperties": false
            }
          },
          "persons": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["personId", "role"],
              "properties": { "personId": { "type": "string", "pattern": "^[1-9]\\d*$" }, "role": { "enum": ["founder", "leader"] } },
              "additionalProperties": false
            }
          },
          "note": { "type": "string" },
          "citations": { "type": "array", "minItems": 1, "items": { "$ref": "citation.schema.json" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": { "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" } }
}
