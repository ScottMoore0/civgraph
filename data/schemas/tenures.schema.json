{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://civgraph.net/schemas/tenures.schema.json",
  "title": "Tenures (data/offices/tenures/*.json)",
  "description": "Who held an office, from when to when, how the tenure began and ended where a source says, each cited. A date the source does not give is null; precision is the precision of the date as given. A council seat filled by co-option is a tenure that began 'co-opted', never an election.",
  "type": "object",
  "required": ["schemaVersion", "description", "tenures"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "description": { "type": "string" },
    "tenures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "personId", "officeId", "start", "startPrecision", "end", "endPrecision", "began", "ended", "citations"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+:\\d+:(\\d{4}(-\\d{2}){0,2}|(to|by)-\\d{4}(-\\d{2}){0,2})(:\\d+)?$" },
          "personId": { "$ref": "#/$defs/personId" },
          "officeId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "start": { "$ref": "#/$defs/dateOrNull" },
          "startPrecision": { "$ref": "#/$defs/precisionOrNull" },
          "end": { "$ref": "#/$defs/dateOrNull" },
          "endPrecision": { "$ref": "#/$defs/precisionOrNull" },
          "startBy": { "$ref": "#/$defs/date", "description": "Where the start is not known: the date a source shows the person already in post (start is then null). Its precision is the precision it carries." },
          "began": { "enum": ["elected", "appointed", "co-opted", "acting", "by-succession", null] },
          "ended": { "enum": ["resigned", "dismissed", "died", "term-ended", "defeated", "office-abolished", null] },
          "predecessor": { "$ref": "#/$defs/personId" },
          "successor": { "$ref": "#/$defs/personId" },
          "contest": { "type": "string", "pattern": "^[a-z0-9-]+__\\d{4}-\\d{2}-\\d{2}$", "description": "The internal contest (an election key) the tenure began with." },
          "note": { "type": "string" },
          "matchedBy": { "type": "string", "description": "How the person was identified: the evidence, never the name alone." },
          "citations": { "type": "array", "minItems": 1, "items": { "$ref": "citation.schema.json" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "personId": { "type": "string", "pattern": "^[1-9]\\d*$" },
    "date": { "type": "string", "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$" },
    "dateOrNull": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
    "precisionOrNull": { "enum": ["year", "month", "day", null] }
  }
}
