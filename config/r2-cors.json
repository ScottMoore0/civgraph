{
  "rules": [
    {
      "allowed": {
        "methods": ["GET", "HEAD"],
        "origins": [
          "https://civgraph.net",
          "https://civgraph.pages.dev",
          "http://localhost:8080",
          "http://localhost:5050",
          "http://127.0.0.1:5050",
          "http://localhost:4177",
          "http://127.0.0.1:4177"
        ],
        "headers": ["*", "Range"]
      },
      "exposeHeaders": ["Accept-Ranges", "Content-Length", "Content-Range", "ETag"],
      "maxAgeSeconds": 86400
    }
  ]
}
