exports[`template snapshots 1`] = `
"\\n<header class=\\"cg-record-header\\">\\n<p class=\\"cg-kicker\\">Person</p>\\n<h1>Gerry Adams</h1>\\n<p class=\\"cg-lede\\">Sinn Féin / 1982-2016 / 15 contests</p>\\n<ul class=\\"cg-badge-list\\"><li><span class=\\"cg-badge\\">15 contests</span></li><li><span class=\\"cg-badge cg-badge--success\\">elected 13 times</span></li></ul>\\n</header>\\n\\n<dl class=\\"cg-facts\\"><dt>Born</dt><dd>6 October 1948</dd><dt>Parties</dt><dd>Sinn Féin (15)</dd><dt>Constituencies</dt><dd>Belfast West (12), Louth (2), Northern Ireland</dd><dt>Bodies</dt><dd>House of Commons of the United Kingdom, Dáil Éireann, Northern Ireland Forum for Political Dialogue</dd><dt>Years</dt><dd>1982–2016</dd><dt>First preferences</dt><dd>206,792</dd><dt>Wikidata</dt><dd><a href=\\"https://www.wikidata.org/wiki/Q76139\\" rel=\\"noopener\\">Q76139</a></dd></dl>\\n<p><a class=\\"cg-button cg-button--primary\\" href=\\"/maps/#layers=election-dail-eireann-2016-02-26\\">Open the latest election on the map</a></p>\\n<h2 id=\\"candidacies\\">Candidacies</h2>\\n<div class=\\"cg-table-wrap\\" role=\\"region\\" aria-label=\\"Candidacies\\" tabindex=\\"0\\"><table class=\\"cg-table cg-table--sticky-first\\"><thead><tr><th scope=\\"col\\">Date</th><th scope=\\"col\\">Election</th><th scope=\\"col\\">Constituency</th><th scope=\\"col\\">Party</th><th scope=\\"col\\" class=\\"cg-num\\">First preferences</th><th scope=\\"col\\" class=\\"cg-num\\">Share</th><th scope=\\"col\\">Result</th></tr></thead><tbody><tr class=\\"cg-elected\\"><th scope=\\"row\\">26 February 2016</th><td><a href=\\"/browse/elections/dail-eireann-2016-02-26\\">2016 Irish general election</a></td><td><a href=\\"/browse/elections/dail-eireann-2016-02-26-louth\\">Louth</a></td><td>Sinn Féin</td><td class=\\"cg-num\\">10,661</td><td class=\\"cg-num\\">15.8%</td><td><span class=\\"cg-elected-mark\\" aria-hidden=\\"true\\">&#10003;</span> Made Quota</td></tr><tr class=\\"cg-elected\\"><th scope=\\"row\\">30 May 1996</th><td><a href=\\"/browse/elections/northern-ireland-forum-for-political-dialogue-1996-05-30\\">1996 Northern Ireland Forum election</a></td><td><a href=\\"/browse/elections/northern-ireland-forum-for-political-dialogue-1996-05-30-regional-list\\">Northern Ireland</a></td><td>Sinn Féin</td><td class=\\"cg-num\\"></td><td class=\\"cg-num\\"></td><td><span class=\\"cg-elected-mark\\" aria-hidden=\\"true\\">&#10003;</span> Elected</td></tr><tr class=\\"cg-elected\\"><th scope=\\"row\\">9 June 1983</th><td><a href=\\"/browse/elections/house-of-commons-of-the-united-kingdom-1983-06-09\\">1983 UK general election in Northern Ireland</a></td><td><a href=\\"/browse/elections/house-of-commons-of-the-united-kingdom-1983-06-09-belfast-west\\">Belfast West</a></td><td>Sinn Féin <span class=\\"cg-muted\\">(printed: Provisional Sinn Féin)</span></td><td class=\\"cg-num\\">16,379</td><td class=\\"cg-num\\">37.9%</td><td><span class=\\"cg-elected-mark\\" aria-hidden=\\"true\\">&#10003;</span> Elected</td></tr></tbody></table></div>\\n\\n\\n<h2 id=\\"relatives\\">Relatives</h2>\\n<ul><li>brother: <a href=\\"/browse/persons/example-relative-1\\">Example &lt;Relative&gt;</a></li></ul>\\n<h2 id=\\"sources\\">Sources</h2>\\n<ol class=\\"cg-citations\\"><li><a href=\\"https://members.parliament.uk/member/645/career\\" rel=\\"noopener\\">UK Parliament Members API</a> <span class=\\"cg-citations__licence\\">(Open Parliament Licence)</span></li><li>A javascript: link is dropped</li><li>Wikidata – date of birth</li></ol>\\n"
`;

exports[`template snapshots 2`] = `
